<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="row">
            <div class="col-8 offset-2 mt-3">
                <h3>Listing Details : </h3>
            </div>


            <div class="card col-6 offset-2 mt-3">
                
                <img src="<%=listing.image%>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <h5 class="card-title">
                      <b>
                        <%=listing.title%>
                      </b>  
                    </h5>
                    <p class="card-text">
                        <%=listing.description%>
                    </p>
                    <p>
                        &#x20B9; <%=listing.price.toLocaleString("en-IN")%>
                    </p>
                    <p>
                        <%=listing.country%>
                    </p>
                    <p>
                        <%=listing.location%>
                    </p>
                    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit Listing details</a>
                    <br><br>
                    <form method="POST" action="/listings/<%=listing._id%>?_method=Delete">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            </div>
            <ul>





        </div>
        </div>
    </body>