<% layout('/layouts/boilerplate') -%>

    <body>

        <div class="row">
            <div class="col-8 offset-2 mt-3">
                <h3>Add New Listing</h3>
                
                <form method="post" action="/listings">
                    <div class="mb-3">
                        <label for="title" class="form-label">Enter hotel Name : </label>
                        <input type="text" id="title" name="listing[title]" placeholder="Enter title here"
                            class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Enter Description : </label>
                        <textarea id="description" rows="5" cols="30" name="listing[description]"
                            placeholder="Enter description here" class="form-control"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Enter hotel image URL : </label>
                        <input type="text" id="image" name="listing[image]" placeholder="Enter image link here"
                            class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">Enter Price : </label>
                        <input type="number" id="price" name="listing[price]" class="form-control" placeholder="1200" />
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="country" class="form-label">Enter country : </label>
                            <input type="text" id="country" name="listing[country]" placeholder="Inida"
                                class="form-control" />

                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="location" class="form-label">Enter Location : </label>
                            <input type="text" id="location" name="listing[location]" placeholder="Bangalore, Karnataka"
                                class="form-control" />
                        </div>
                    </div>
                    <br>
                    <button class="btn btn-dark add-btn">Add</button>
                </form>
            </div>
        </div>
    </body>