<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit : <%= listing.title %></title>
</head>
<body>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%=listing.id%>?_method=PUT">
        <label for="title">Enter your hotel Name : </label>
        <input type="text" id="title" name="listing[title]" value="<%= listing.title %>"/>
        <br><br>
        <label for="description">Enter Description : </label>
        <textarea id="description" rows="5" cols="30" name="listing[description]" ><%= listing.description %></textarea>
        <br><br>
        <label for="image">Enter your hotel image/URL : </label>
        <input type="text" id="image" name="listing[image]" value="<%= listing.image %>"/>
        <br><br>
        <label for="price">Enter Price : </label>
        <input type="number" id="price" name="listing[price]" value="<%= listing.price %>"/>
        <br><br>
        <label for="country">Enter your country : </label>
        <input type="text" id="country" name="listing[country]" value="<%= listing.country %>"/>
        <br><br>
        <label for="location">Enter Location : </label>
        <input type="text" id="location" name="listing[location]" value="<%= listing.location %>"/>
        <br><br>
        <button>Edit</button>
    </form>
</body>
</html>